# ── En-têtes de sécurité (toutes les routes) ────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ── Cache long pour les médias (images, icônes, OG) ─────────────────────────
# Noms de fichiers stables : on peut mettre en cache 1 an de façon immuable.
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── CSS / JS : cache court avec revalidation ────────────────────────────────
# Noms de fichiers non versionnés : revalidation rapide pour que tes
# mises à jour soient visibles sans attendre.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate
